[core]
  editor = "nvim"
  pager = delta

[delta]
  navigate = true
  syntax-theme = base16
  line-numbers = true

[user]
  name = lightclient
  email = lightclient@protonmail.com
  signingkey = 062431612E12367DAE0E24766E5E56B80EE509D2

[init]
  defaultBranch = main

[diff]
  colorMoved = default

[gpg]
  program = gpg

[commit]
  gpgsign = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[credential]
	helper = store

[url "git@github.com:ethereum/go-ethereum"]
  insteadOf = https://github.com/ethereum/go-ethereum
